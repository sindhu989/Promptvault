PORT=5000
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
APP_URL=http://localhost:4173
RESEND_API_KEY=
RESEND_FROM=PromptVault <no-reply@your-verified-domain.com>
# Optional: use a real MongoDB URI for persistent storage.
# MONGODB_URI=mongodb://localhost:27017/promptvault
# Without MONGODB_URI, development data is stored in backend/.data/store.json.
