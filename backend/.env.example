PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
MONGODB_URI=mongodb://localhost:27017/promptvault
APP_URL=http://localhost:4173
# Optional comma-separated origins for a separately hosted frontend.
CORS_ORIGINS=
# Optional first-admin bootstrap settings. Remove after first admin promotion.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_SECRET=
RESEND_API_KEY=
RESEND_FROM=PromptVault <no-reply@your-verified-domain.com>
